# Active application configuration (read by the FastAPI application)
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Required only when running scripts/check_postgres.py.
# Supply a real PostgreSQL URL locally; never commit it.
# Set a valid PostgreSQL connection URI locally; do not commit its value.
DATABASE_URL=

# Reserved for authentication implementation; no secret is supplied.
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Reserved for planned S3-compatible storage integration.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Reserved for planned worker integration.
REDIS_URL=redis://localhost:6379/0

# Reserved for planned OCR integration; not currently consumed.
OCR_ENGINE=paddleocr

# The planned classifier is local; no external AI/ML provider key is needed.

# Reserved for frontend API integration; not currently consumed by the UI.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# The existing SQLite store optionally reads RECORDA_SCHEDULE_DB.
# Leave it unset to preserve the store's existing default path.
